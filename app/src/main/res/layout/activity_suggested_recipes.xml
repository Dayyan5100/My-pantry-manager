<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android = "http://schemas.android.com/apk/res/android"
    android:id=  "@+id/main"
    android:layout_width   = "match_parent"
    android:layout_height= "match_parent"
    android:orientation =  "vertical">

    <!-- loads the toolbar -->
    <include layout= "@layout/view_toolbar" />


    <!-- holds the suggested recipes content -->
    <LinearLayout
        android:layout_width =  "match_parent"
        android:layout_height = "0dp"
        android:layout_weight   = "1"
        android:orientation= "vertical"
        android:padding =   "20dp">


        <!-- introduction text -->
        <TextView
            android:layout_width = "match_parent"
            android:layout_height  = "wrap_content"
            android:text =  "@string/suggestions_intro"
            android:textSize= "18sp" />
        <!-- tells the user to tap a recipe for more details -->
        <TextView
            android:layout_width  = "match_parent"
            android:layout_height = "wrap_content"
            android:layout_marginTop =  "12dp"
            android:text=   "@string/recipes_tap_hint" />


        <!-- shows loading, errors or when no recipes match -->
        <TextView
            android:id  = "@+id/text_recipes_status"
            android:layout_width=  "match_parent"
            android:layout_height = "wrap_content"
            android:layout_marginTop=   "20dp"
            android:accessibilityLiveRegion = "polite"
            android:text= "@string/recipes_loading"
            android:textSize =   "16sp" />
        <!-- button for trying to load the recipes again -->
        <Button
            android:id= "@+id/button_retry_recipes"
            android:layout_width   = "wrap_content"
            android:layout_height=  "wrap_content"
            android:text = "@string/retry"
            android:visibility=   "gone" />


        <!-- listview is used to display multiple recipes -->
        <!-- displays recipes that match the pantry -->
        <ListView
            android:id=  "@+id/list_recipes"
            android:layout_width = "match_parent"
            android:layout_height= "0dp"
            android:layout_weight =  "1"
            android:layout_marginTop   = "12dp"
            android:visibility= "gone" />

    </LinearLayout>


</LinearLayout>