<?xml version="1.0" encoding="utf-8"?>


<LinearLayout
    xmlns:android=  "http://schemas.android.com/apk/res/android"
    android:id= "@+id/main"
    android:layout_width= "match_parent"
    android:layout_height   = "match_parent"
    android:orientation=   "vertical">


    <!-- loads the toolbar -->
    <include layout =   "@layout/view_toolbar" />


    <!-- allows the screen content to scroll -->
    <ScrollView
        android:layout_width= "match_parent"
        android:layout_height =  "0dp"
        android:layout_weight=   "1"
        android:fillViewport= "true">

        <!-- holds the suggested recipes content -->
        <LinearLayout
            android:layout_width = "match_parent"
            android:layout_height=  "wrap_content"
            android:orientation =   "vertical"
            android:padding= "20dp">


            <!-- introduction text -->
            <TextView
                android:layout_width   = "match_parent"
                android:layout_height= "wrap_content"
                android:text=  "@string/suggestions_intro"
                android:textSize=   "18sp" />

            <!-- temporary recipe suggestion message -->
            <TextView
                android:layout_width= "match_parent"
                android:layout_height   = "wrap_content"
                android:layout_marginTop = "20dp"
                android:text =   "@string/suggestions_preview"
                android:textSize= "16sp" />
            <!-- opens the recipe detail preview -->
            <Button
                android:id=   "@+id/button_preview_recipe"
                android:layout_width= "match_parent"
                android:layout_height=  "wrap_content"
                android:layout_marginTop   = "20dp"
                android:text= "@string/open_detail_preview" />


        </LinearLayout>
    </ScrollView>

</LinearLayout>
